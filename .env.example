# =============================================================================
# ISiK conformance test environment - deployment configuration
# =============================================================================
# Copy to `.env` and edit. Every value here is a deploy-time decision.
#
#   cp .env.example .env
#
# Values are consumed by the Makefile, by scripts/*, and by docker compose.
# `make resolve` reads this file and writes `.env.resolved`, which additionally
# records image digests. `.env.resolved` is the provenance record referenced by
# the generated documentation - treat it as the authoritative statement of what
# was actually tested.
#
# Credentials. Leave the two password fields empty and each deployment generates
# its own, easy-to-read, and stores it in secrets/ (see secrets/README.md).
# `.env` itself then holds no password, but `.env.resolved` does: it is written
# mode 0600 and is gitignored, as is secrets/. That is the only rule here -
# passwords must not reach source control. They are otherwise documented on
# purpose: this is a single-round lab environment, and every generated report
# states the credentials it used so a tester can reproduce any verdict by hand.
# `make credentials` prints them; run/CREDENTIALS.md is the sheet.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Deploy mode
# -----------------------------------------------------------------------------
# MODE governs the UNIT UNDER TEST and the run behaviour. It deliberately does NOT
# govern the test tool's version - that is TESTSUITE_VERSION_TRACK in section 3,
# for reasons given there. The two are separate because floating the SUT is free
# and floating the test definition is not.
#
# latest  Resolves the newest IRIS for Health and Web Gateway tags matching
#         IRIS_VERSION_TRACK. The DEFAULT: a conformance round should normally be
#         measured against the newest available build of the product. The exact
#         build is still fully identified afterwards - .env.resolved records the
#         registry digest and the IRIS build string - it just cannot be re-created
#         from this file alone at a later date, because the tag will have moved.
#
# pinned  Uses IRIS_VERSION / WEBGATEWAY_VERSION verbatim. Use this when the round
#         must be re-creatable from .env months later, or to test a specific build
#         (for instance the one a licence key was issued for).
#
# manual  As pinned, and then leaves the environment running for interactive
#         testing: the test suite starts with the Tiger WorkflowUI and does not
#         auto-run.
#
MODE=latest


# -----------------------------------------------------------------------------
# 2. Unit under test - InterSystems IRIS for Health
# -----------------------------------------------------------------------------
# The official licensed image. Requires `docker login containers.intersystems.com`
# and a licence key at secrets/iris.key.
IRIS_IMAGE=containers.intersystems.com/intersystems/irishealth

# Used verbatim when MODE=pinned or MODE=manual. Under MODE=latest it is the
# fallback for a registry that cannot be enumerated (no credential, no token realm,
# empty tag list), so it should always name a build that exists.
#
# Set it to a build your licence key covers. A key is issued for a named product,
# a capacity, a platform family and an expiry date - see secrets/README.md for what
# to check before a round rather than during one.
IRIS_VERSION=2026.2

# Used only when MODE=latest, to constrain which tags are considered "latest".
# A bare major.minor prefix; e.g. 2026 matches 2026.1, 2026.2, 2026.2.0.221.0.
# Preview, beta, alpha, EM and RC tags are excluded regardless: a conformance
# baseline has to be measured on a released build.
IRIS_VERSION_TRACK=2026

# Host ports published by the stack. Changed only if they collide on the
# deployment host; the test suite reaches the SUT over the isolated subnet and does
# not use these.
#
# IRIS_PORT_WEB is the FHIR server's HTTP port as far as every operator, document
# and firewall rule is concerned, and it keeps that name and its conventional value
# - but it is published by the webgateway container (mapped to its :80), not by
# IRIS, which serves no HTTP at all. See section 2b.
IRIS_PORT_WEB=52773
IRIS_PORT_SUPER=51972

# FHIR endpoint paths. Two namespaces / two endpoints, because ISiK Stufe 3 and
# Stufe 5 pin mutually incompatible versions of de.basisprofil.r4 (1.4.0 vs
# 1.5.4) and a single IRIS namespace cannot hold both.
IRIS_NS_STUFE3=ISIK3
IRIS_NS_STUFE5=ISIK5
FHIR_BASE_STUFE3=/isik3/fhir/r4
FHIR_BASE_STUFE5=/isik5/fhir/r4

# FHIR API user created by the bootstrap. The test suite authenticates as this
# user via HTTP Basic. Leave SUT_PASSWORD empty to have one generated at
# `make resolve` time and stored in secrets/sut.password - generated passwords
# are of the form Kmrf-7xtq-Vhn3-Pd2s, which satisfies IRIS's default password
# policy, so the instance keeps its production-like security configuration.
SUT_USER=isikapi
SUT_PASSWORD=

# The IRIS Management Portal account, for the human tester. The bootstrap sets
# this password on the predefined accounts and marks them non-expiring; without
# it the portal is unusable, because the official image ships them expired.
# _SYSTEM is the conventional choice; SuperUser also works. Leave the password
# empty to have one generated into secrets/iris-mgmt.password.
IRIS_MGMT_USER=_SYSTEM
IRIS_MGMT_PASSWORD=

# How long `make up` waits for the FHIR endpoints, in seconds. The bring-up is
# dominated by the FHIR package import and by profile validator initialisation:
# measured at 4m40s for a cold install on an 8-vCPU host and 7s when the namespaces
# already exist, but the import is I/O bound, so a slow disk, a cold package cache
# or a memory-constrained host moves it a long way. This default (90 minutes) is
# therefore a ceiling and not an expectation: it is deliberately generous, because
# abandoning a working installation
# costs far more time than waiting out a broken one - and a genuinely broken
# bootstrap is detected immediately from its status file, not by this timeout.
IRIS_BOOTSTRAP_TIMEOUT=5400

# The uid the official image runs IRIS as. `make up` gives run/iris-state to this
# uid so the container can write its bootstrap log and provenance record into the
# bind mount; without that the log is unwritable and a failing bootstrap reports
# only a generic timeout instead of its actual error. 51773 is irisowner in
# irishealth 2026.2 - change it only if a future image changes the account.
IRIS_CONTAINER_UID=51773

# Endpoint tuning applied by iris/src/ISiK/Setup.cls. The suite issues searches
# with _count=20 and several unbounded searches; IRIS defaults are lower.
# Deviations from IRIS defaults are declared in docs/en/03-sut-iris.md.
FHIR_DEFAULT_PAGE_SIZE=100
FHIR_MAX_PAGE_SIZE=500
FHIR_MAX_SEARCH_RESULTS=10000

# Prefer-handling for unknown search parameters. `lenient` makes IRIS ignore
# parameters it does not know instead of rejecting the request. Set to `strict`
# to surface unsupported search parameters as hard errors instead - useful for
# gap analysis, but it changes what the suite measures. See
# docs/en/03-sut-iris.md before changing.
FHIR_PREFER_HANDLING=lenient


# -----------------------------------------------------------------------------
# 2b. HTTP front end for the unit under test - InterSystems Web Gateway
# -----------------------------------------------------------------------------
# The IRIS for Health images ship no web server. Not "an unconfigured one" - none
# at all: only 1972 and 2188 listen, there is no httpd/apache2/nginx binary in the
# image, iris.cpf carries WebServer=0, and the image's own parameters.isc records
# `csp_gateway.configure_apache: N`. The images nonetheless declare 52773/tcp in
# ExposedPorts and label it as the webserver port, which is what makes the absence
# easy to miss. No IRIS variant in the registry bundles one either.
#
# So the rig runs the separate official Web Gateway image in front of IRIS. That is
# the supported InterSystems deployment for HTTP and the same topology a production
# ISiK deployment would use, which keeps the SUT representative of the product as
# shipped rather than of a workaround. It is part of the SUT, not test scaffolding:
# every FHIR request the suite issues passes through it.
#
# The Apache-based image is the default. Two drop-in alternatives are published and
# both work here without further changes - override the image name at deploy time:
#   containers.intersystems.com/intersystems/webgateway-nginx        (nginx)
#   containers.intersystems.com/intersystems/webgateway-lockeddown   (hardened)
WEBGATEWAY_IMAGE=containers.intersystems.com/intersystems/webgateway
WEBGATEWAY_VERSION=2026.2

# Version-matched to IRIS_VERSION on purpose. The Web Gateway is supported against
# a range of IRIS versions, but matching removes the question from a conformance
# report entirely - no reviewer has to ask whether a gateway/kernel version skew
# explains a failed assertion. In MODE=latest this is re-resolved alongside IRIS.

# Static address on the isolated subnet, in the same block as the other two. This
# is the address the test suite and the IRIS healthcheck use to reach the FHIR
# endpoints, so it appears in the rendered Tiger configuration literally.
WEBGATEWAY_IP=172.31.0.30

# The port Apache listens on inside the gateway container. The image serves :80;
# change this only if a custom or overridden gateway image listens elsewhere. The
# host-published port is IRIS_PORT_WEB in section 2.
WEBGATEWAY_PORT_INTERNAL=80

# The IRIS account the gateway authenticates with for its own service connection -
# not the FHIR credential, which is SUT_USER. CSPSystem is the account IRIS
# provides for this; the bootstrap gives it IRIS_MGMT_PASSWORD and the rendered
# CSP.ini gets the same value, so the two cannot drift. Without a working
# credential here the gateway logs "Connection Validation Failed ... Access Denied"
# and Apache answers every FHIR request with a bare HTTP 500.
GATEWAY_IRIS_USER=CSPSystem


# -----------------------------------------------------------------------------
# 3. Test tool - Gematik ISiK test suite
# -----------------------------------------------------------------------------
# gematik1/isik-testsuite. 2.7.0 is the latest release (published 2026-07-06;
# confirmed still current on 2026-08-07).
#
# PINNED ON PURPOSE, and not floated by MODE=latest the way the SUT is. Four things
# are fixed by this one number, and only the first is visible in a report:
#
#   * the scenario inventory, and therefore the expected case counts (506 / 895);
#   * the FHIR package versions the bundled reference validator validates against;
#   * the ${data.*} placeholder contract that this repository's authored test data
#     in testdata/ has to satisfy exactly;
#   * which upstream test-suite defects need working around, and how.
#
# The third is the dangerous one. A release that renames or re-shapes a placeholder
# does not fail loudly: the corpus still seeds, and a scenario then asserts against
# data that is not what its feature file expects - which surfaces as a conformance
# gap in the SUT. That misattribution is the one thing this project exists to avoid.
TESTSUITE_IMAGE=gematik1/isik-testsuite
TESTSUITE_VERSION=2.7.0

# Leave EMPTY to use TESTSUITE_VERSION above; the only other accepted value is
# `latest`, which resolves the newest published GitHub release instead.
#
# Empty is the default and the right answer for a round whose result will be
# reported. Setting `latest` is a deliberate act with follow-up work attached: the
# test-data corpus must be re-verified against the new release's feature files
# (`make check` section 5, then docs/en/05-testdata.md) before the round counts as
# a conformance result. INSTALL.md section 6 has the checklist.
#
# Either way, `make resolve` looks the newest release up and records it as
# TESTSUITE_LATEST_AVAILABLE in .env.resolved, warning when the pin is behind - so
# a stale pin is a visible fact in the report rather than a discovery made later.
TESTSUITE_VERSION_TRACK=

# GitHub repository used to discover the newest release - both for
# TESTSUITE_VERSION_TRACK=latest and for the staleness notice above - and by
# `make packages` when PACKAGE_SOURCE=refv is unavailable.
TESTSUITE_REPO=gematik/isik-testsuite

# Cucumber tag expressions. The defaults reproduce the official certification
# scope (all mandatory, no optional tests) and match the pom.xml profile
# defaults exactly. Narrow them only for debugging - a narrowed run is not a
# conformance run.
#
# Quoted because this file is read two ways: `docker compose --env-file` parses it
# itself (and strips the quotes), but scripts/lib.sh `load_env` *sources* it in
# bash, where an unquoted "(" is a syntax error. Keep the quotes on any value
# containing spaces, parentheses or other shell metacharacters.
TESTS_TO_RUN_STUFE3="@Stufe3 and (not @Optional)"
TESTS_TO_RUN_STUFE5="@Stufe5 and (not @Optional)"

# The third invocation, `make test-connect`, which exists only when
# CONNECT_ENABLE=true (see the authorization server section near the end of this
# file). It runs the Stufe 5 `Connect` module a SECOND time, with real bearer
# tokens instead of the credential the Tiger proxy injects for the other nine
# modules; the complete Stufe 5 scope above is unaffected by it and remains the
# round's submission artefact. Do not widen this one: the other nine modules
# cannot run through the Connect configuration, which deliberately adds no
# credential to a request.
TESTS_TO_RUN_CONNECT="@Stufe5 and @Connect and (not @Optional)"

# Host ports published by the test suite container.
TESTSUITE_PORT_WORKFLOW_UI=9010
TESTSUITE_PORT_PROXY_LOG=9011

# Wall-clock ceiling for one Stufe, in seconds. Stufe 5 executes 895 test cases
# (Stufe 3: 506); a slow host with a cold Maven cache can take well over an hour.
# The run is killed and the partial report archived if this is exceeded.
TESTSUITE_TIMEOUT=10800

# Maximum heap for the JVM that runs the scenarios, as a -Xmx value.
#
# THIS IS NOT A PERFORMANCE TUNABLE. Too small a value does not merely slow a
# Stufe 5 run down, it destroys the round, and it does so without ever reporting
# an error the run's own exit code can see. Measured on the lab host:
#
#   Tiger's RbelLogger retains a parsed tree of every HTTP message of the whole
#   run. Stufe 5 sends several times Stufe 3's traffic, so at roughly 600 of its
#   895 cases the heap filled, the Rbel parser threads died of OutOfMemoryError,
#   and every subsequent scenario blocked for the full 100-second parse timeout
#   in RbelMessageHistory.waitForGivenMessagesToBeParsed. Throughput collapsed
#   from ~12 scenarios/minute to ~0.5, which projects the remaining 281 cases to
#   about 9 hours against the 3-hour TESTSUITE_TIMEOUT above. A timeout produces
#   NO archive at all (Maven assembles it in post-integration-test), so the whole
#   level would have been lost after hours of apparently healthy progress. The
#   container sat at 0.3% CPU throughout, which reads like an idle hang rather
#   than the memory exhaustion it was. Stufe 3 completes well inside the default
#   and never showed this.
#
# The default is left to the JVM, which takes 1/4 of the host's RAM - the value
# that was NOT enough on a 31 GiB host (7.84 GiB). Set this explicitly.
#
# Delivered to the forked Failsafe JVM as MAVEN_ARGS=-DargLine=-Xmx<value>. It
# has to be argLine and not MAVEN_OPTS: MAVEN_OPTS sizes the Maven JVM, while the
# scenarios - and the Rbel history - live in the JVM Failsafe forks, which is the
# one that ran out of memory.
#
# Budget at least 16g for Stufe 5 and leave the host several GiB for IRIS (about
# 2.2 GiB resident) and the Web Gateway. Empty means "use the JVM default", which
# 00-preflight.sh warns about when the host has less than 32 GiB.
#
# Overridable on the command line, unlike most of this file:
#
#   TESTSUITE_HEAP_MAX=32g make test-stufe5 RUN_ID=run-20260807T084713Z
#
# which re-runs one level of an existing round with more heap - the documented
# response to the stall above. The override is logged when it takes effect and is
# recorded in that level's run.json as `overrides`, so the archive states it. The
# same applies to TESTSUITE_TIMEOUT, IRIS_BOOTSTRAP_TIMEOUT and MANUAL_STUFE; the
# list lives in RUN_OVERRIDABLE in scripts/lib.sh, alongside CONFIG_OVERRIDABLE for
# MODE and PACKAGE_SOURCE. Every other setting here is
# file-only on purpose, because .env.resolved is the provenance record: a version
# or an endpoint that could be changed per invocation would let a round test one
# thing and record another.
TESTSUITE_HEAP_MAX=16g

# --- MODE=manual only --------------------------------------------------------
# Which specification level the WorkflowUI offers. One container runs exactly one
# Maven profile, so only one level is available per `make manual`; switch with
# `make clean && MANUAL_STUFE=stufe3 make manual`.
MANUAL_STUFE=stufe5

# Tag expression offered in the WorkflowUI. Unlike an unattended run this is not a
# conformance scope - it only preselects what is listed - so widening it (e.g. by
# dropping `not @Optional`) is harmless here.
TESTS_TO_RUN_MANUAL="@Stufe5 and (not @Optional)"

# How long `make manual` waits for the WorkflowUI to bind, in seconds. Exceeding
# it is reported but not treated as a failure: the container may simply be slow to
# resolve its Maven reactor.
MANUAL_UI_TIMEOUT=600


# -----------------------------------------------------------------------------
# 4. FHIR package acquisition
# -----------------------------------------------------------------------------
# Which package VERSIONS are loaded into IRIS is decided by the test suite image
# either way: the authoritative name@version list comes from the image's own
# refv-plugins/*/config.yaml. This setting decides where the package *payloads*
# come from - which, as the 2026.2 round found out, is not always the same thing.
#
# refv        Use the .tgz files bundled inside the image's refv-plugins/*.zip.
#             Needs no internet access beyond the image pull. DEFAULT, and the
#             right choice for a round that will be submitted: the reference
#             validator validates against these exact copies, so the SUT enforces
#             what it is judged against.
#
# simplifier  Additionally download the same name@version tarballs from
#             packages.simplifier.net, use those as the payload, and record a
#             parity table bundled-vs-published in vendor/packages/PARITY.txt with
#             field-level detail in PARITY-DETAIL.txt. Slower, and it produces
#             evidence about the bundled packages rather than a better round.
#
#             Two things to expect, both real and both from suite 2.7.0:
#
#             - Some packages are not on Simplifier at all -
#               de.gematik.isik3-dokumentenaustausch-terminology#1.0.0 is not.
#               Those are filled from the image and marked BUNDLED, which
#               corroborates nothing for that row.
#             - THREE packages are published in a genuinely different form:
#               de.gematik.isik-terminplanung#3.1.1 (a differently defined
#               ISiKKalender, internally still stamped 3.0.9 in the image),
#               de.gematik.isik#5.1.2 (a mustSupport element missing from the
#               published ISiKOrganisationFachabteilung) and
#               de.medizininformatikinitiative.kerndatensatz.medikation#1.0.11 (a
#               filename typo). Those rows read DIFFER. Loading them would have the
#               SUT enforce different profiles than the validator asserts, so a
#               submitted round should use refv. See docs/en/02-setup.md.
#
#             Most rows read EQUIV, not MATCH: the image ships snapshot-generated
#             StructureDefinitions where Simplifier serves differential-only ones.
#             EQUIV means the definitions agree and is evidence of the same
#             strength as MATCH.
PACKAGE_SOURCE=refv

SIMPLIFIER_REGISTRY=https://packages.simplifier.net


# -----------------------------------------------------------------------------
# 5. Isolated network
# -----------------------------------------------------------------------------
# A dedicated /24 so the whole test round can be firewalled by a single CIDR.
# Internet access (image pulls, Simplifier downloads) is NAT'd through the
# gateway, which is the host.
#
# Addresses are static so that the rendered Tiger configuration, the seed
# scripts and any host firewall rules can all refer to them literally.
ISIK_SUBNET=172.31.0.0/24
ISIK_GATEWAY=172.31.0.1
IRIS_IP=172.31.0.10
TESTSUITE_IP=172.31.0.20

# Name given to the host-side bridge interface, so firewall rules can target it
# by name (`iptables -i br-isik ...`) rather than by a Docker-generated id.
ISIK_BRIDGE_NAME=br-isik

# Docker Compose project name. Keeps container/volume/network names stable and
# predictable across deployments.
COMPOSE_PROJECT_NAME=isik


# -----------------------------------------------------------------------------
# 6. Seeding
# -----------------------------------------------------------------------------
# Validate every seeded resource with the endpoint's own $validate operation
# before the conformance run. Non-conformant test data would otherwise be
# reported as a SUT gap, which is exactly the confusion the gap report must
# avoid. Turn off only to debug the seeder itself.
SEED_VALIDATE=1

# Abort `make seed` if any resource fails $validate. Leave at 1 for reportable
# runs. Setting it to 0 records failures as TEST_DATA_DEFECT entries in the gap
# report and proceeds.
SEED_VALIDATE_STRICT=1

# Validate the rendered corpus with the *test suite's own* reference validator
# before anything is written (seed stage 4), rather than with the endpoint's
# $validate above. The two answer different questions: $validate says whether
# IRIS accepts the body, this says whether the suite would accept it on the way
# back out - which is the verdict that ends up in the official report. A body
# that fails here produces a failing scenario that reads as a product defect and
# is not one.
#
# Needs docker and the pinned suite image, and adds roughly a minute to
# `make seed`. Setting it to 0 is a decision to publish a gap count the rig
# cannot stand behind, so the skip is warned about rather than silent.
CORPUS_REFV_VALIDATE=1


# -----------------------------------------------------------------------------
# 7. Authorization server (ISiK Stufe 5 "Connect")
# -----------------------------------------------------------------------------
# The suite's `Connect` module presents OAuth 2.0 / SMART-on-FHIR access tokens
# and asserts what the FHIR server does with them. It therefore needs two things
# no other module needs: an authorization server to issue the tokens, and a TLS
# listener in front of the SUT, because the FHIR server refuses to evaluate a
# bearer token on a connection it does not consider secure.
#
# With CONNECT_ENABLE=false - the default - none of this is deployed, nothing in
# this section is read, and the round is configured exactly as every round taken
# before this section existed. The `Connect` module is then reported as excluded
# for a missing environment prerequisite, which is what it was before.
#
# ADDITIONAL HARDWARE. A round with CONNECT_ENABLE=true needs about 1.1 GiB of
# host memory more than one without (AS_MEM_LIMIT below, plus the Web Gateway's
# TLS listener). IRIS's own default of 25 % of host memory is unchanged by it, so
# the extra GiB has to be real, not borrowed from what IRIS already claims. Note
# also that this rig does not configure HugePages, which InterSystems recommends
# for every host running IRIS; without them IRIS's real memory consumption is
# materially higher than its configured shared-memory size suggests. The sizing
# table and both statements are in INSTALL.md section 2; the module itself, and
# everything this switch turns on, is in docs/en/08-connect.md.
CONNECT_ENABLE=false

# --- The authorization server itself -----------------------------------------
# Keycloak, deliberately not an InterSystems product: the SUT must not issue the
# tokens it then validates, or the test would be circular. See the header of
# compose/authserver.yml. Pinned by tag; the resolved digest is recorded in each
# round's provenance.
AS_IMAGE=quay.io/keycloak/keycloak
AS_VERSION=26.4.7

# Where it lives. AS_HOSTNAME is the name in its certificate and in the issuer
# claim of every token, so it is not cosmetic: IRIS discovers the server under
# this name, and a token whose `iss` does not match what IRIS discovered is
# rejected.
AS_IP=172.31.0.40
AS_HOSTNAME=isik-as
AS_PORT_HTTPS_INTERNAL=8443

# Published on the host so that `make tokens` can mint through the same TLS
# listener the SUT introspects against. Change it if 8443 is taken.
AS_PORT_HTTPS=8443

# The realm the tokens come from. Part of the issuer URL.
AS_REALM=isik

# Access token lifetime in seconds. One hour: long enough for a full Connect
# run plus the retries a failed run needs, short enough that a token left in a
# working copy is useless by the time anyone finds it. `make test` refuses to
# start a Connect round with an expired token rather than reporting the
# resulting 401s as product behaviour.
AS_TOKEN_LIFESPAN=3600

# How much of that lifetime must still be left when a Connect run starts, in
# seconds. The measured wall-clock time of the 32-case Connect module is under
# two minutes, so ten minutes is ample; the check exists because a token that
# expires mid-run turns product behaviour into 401s that look like refusals.
# `make test-connect` mints immediately before the run, so this threshold is
# reached only when tokens were minted by hand and then left lying.
CONNECT_TOKEN_MIN_REMAINING=600

# Memory. The measured resident set of the authorization server under the token
# load of a full Connect run is ~600 MiB with this heap; the limit is stated so
# that this container cannot compete with IRIS for host memory.
AS_MEM_LIMIT=1g
AS_HEAP_MAX=512m

# --- How the SUT knows it -----------------------------------------------------
# AS_CLIENT_NAME is the name of the OAuth 2.0 client definition inside IRIS;
# AS_RESOURCE_CLIENT_ID is the client id the FHIR server authenticates with when
# it introspects a presented token. The two are separate because the first is an
# IRIS configuration object's name and the second is a fact about the
# authorization server.
AS_CLIENT_NAME=ISIKConnect
AS_RESOURCE_CLIENT_ID=isik-resource-server

# Administrator account of the authorization server, and the client secret every
# client in the realm shares. Both are generated per deployment by `make up`,
# like SUT_PASSWORD above, and reported in run/CREDENTIALS.md. Leave empty: a
# value committed here would be a credential in version control, and these are
# credentials even though the environment they protect is a throwaway.
AS_ADMIN_USER=kcadmin
AS_ADMIN_PASSWORD=
AS_CLIENT_SECRET=

# --- The SUT's TLS listener ---------------------------------------------------
# SUT_TLS_HOST is the name the suite addresses the SUT by over HTTPS and the
# name in the SUT's certificate. It must resolve inside the test subnet, which
# it does: it is the Web Gateway container's network alias.
SUT_TLS_HOST=isik-webgateway
SUT_PORT_HTTPS_INTERNAL=443
SUT_PORT_HTTPS=52443

# The value a presented token's `aud` claim must carry, and the audience the
# authorization server stamps into every token it issues for this round. It is
# the Stufe 5 endpoint's own HTTPS URL. Keep the two sides equal - they are
# rendered from this one value for exactly that reason - and keep it in step
# with SUT_TLS_HOST and FHIR_BASE_STUFE5 above.
SUT_AUDIENCE=https://isik-webgateway/isik5/fhir/r4

# The patient the suite's Connect scenarios expect to be "the patient in
# context". It is a value of the suite's own test data
# (testdata/v3/Stufe5/connect.yaml, read-patient-in-context-id), reproduced here
# because the authorization server has to put it into the tokens it issues: there
# is no SMART app launch in these scenarios, so the launch context is configured
# rather than established. `make tokens` verifies that the minted tokens carry
# this value and fails if the two have drifted apart.
CONNECT_PATIENT_IN_CONTEXT=Patient-Read-Example
